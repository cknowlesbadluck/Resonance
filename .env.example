# ─── Supabase (persistence, auth, RLS) ───────────────────────────────────────
# Project: lfdynzionafcpddqipqc. Both public values are safe to ship to clients.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side only. Never expose to the browser or the iOS client — it bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Project scope ───────────────────────────────────────────────────────────
# Must be a UUID. Every Nexus route rejects a non-UUID projectId with a 400,
# so a placeholder like "demo" fails every call.
RESONANCE_PROJECT_ID=
# Same value, exposed to the web dashboard.
NEXT_PUBLIC_RESONANCE_PROJECT_ID=

# ─── Auth mode ───────────────────────────────────────────────────────────────
# required — always demand Bearer + project membership (use this in production)
# optional — never demand auth (local development only; makes writes unauthenticated)
# auto     — demand auth when SUPABASE_SERVICE_ROLE_KEY and NEXT_PUBLIC_SUPABASE_URL are both set
# Any unrecognised value fails closed to `required`.
RESONANCE_AUTH_MODE=required

# development | production — set production on the live host.
RESONANCE_DEPLOY_STAGE=production

# ─── Adapters ────────────────────────────────────────────────────────────────
# Presence of GITHUB_TOKEN is what binds the GitHub adapter and makes
# tool.github / integration.github executable. Without it those capabilities are
# advertised with executable:false and refused at compose time, by design.
GITHUB_TOKEN=
# Required for POST /api/webhooks/github (timing-safe HMAC verification).
GITHUB_WEBHOOK_SECRET=

# Not yet bound to a Nexus adapter — see docs/AUDIT-2026-09-14.md §7 P2-1.
LINEAR_API_KEY=

# ─── CI / verification (optional) ─────────────────────────────────────────────
# Set to 1 together with GITHUB_TOKEN to run the GitHub vertical-slice test.
# GITHUB_VERTICAL_SLICE=1
# GITHUB_OWNER=
# GITHUB_REPO=
# Base URL for `npm run smoke`.
# SMOKE_BASE_URL=https://resonancenexus.netlify.app

# ─── Fair share (optional; defaults are safe) ─────────────────────────────────
# Per-project and per-adapter caps on concurrent adapter invocations. Invalid values fall back to the default.
# RESONANCE_MAX_INFLIGHT_PER_PROJECT=4
# RESONANCE_MAX_CONCURRENT_PER_ADAPTER=8
# Cross-instance fair share via shared leases (opt-in; needs the 20261017090000 lease migration applied by the owner).
# Any Supabase error falls back to the in-memory limits above.
# RESONANCE_SHARED_LEASES=supabase
# RESONANCE_SHARED_LEASE_TTL_SECONDS=120
# RESONANCE_SHARED_LEASE_MAX_WAIT_MS=5000
